# Slack Configuration
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_APP_TOKEN=your_slack_app_token_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Azure Analysis Services Configuration 
AAS_XMLA_ENDPOINT=your_aas_xmla_endpoint_here
AAS_DATABASE=your_aas_database_here
# Cube name in MDX FROM clause — must match the cube name inside that database (often same as model display name)
AAS_CUBE_NAME=your_aas_cube_name_here
AAS_TENANT_ID=your_aas_tenant_id_here
AAS_USERNAME=your_aas_username_here
AAS_PASSWORD=your_aas_password_here
AAS_SERVER=your_aas_server_here

# Genie API (DM / @mention → Genie → Databricks SQL)
DATABRICKS_URL=https://adb-xxxx.azuredatabricks.net/
GENIE_SPACE_ID=your_genie_space_id_here
DATABRICKS_TOKEN=your_databricks_pat_here
